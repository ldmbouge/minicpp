# Only settings that differ from Doxygen's defaults.
# To see every option and its default: doxygen -g

# Project & output
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@/docs"
CREATE_SUBDIRS         = YES
ALLOW_UNICODE_NAMES    = YES

# What to extract
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_STATIC         = YES
BUILTIN_STL_SUPPORT    = YES

SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = YES

# Input
INPUT                  = "@PROJECT_SOURCE_DIR@/README.md" \
                         "@PROJECT_SOURCE_DIR@/docs" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/examples"
EXCLUDE                = "@PROJECT_SOURCE_DIR@/examples/pybench" \
                         "@PROJECT_SOURCE_DIR@/src/util/xxhash.h"
FILE_PATTERNS          = *.h *.hh *.hpp *.c *.cc *.cpp *.cxx *.cu *.cuh *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/src"

# Doxygen doesn't know CUDA extensions by default
EXTENSION_MAPPING      = cu=C++ cuh=C++

# Preprocessor: hide LLVM and CUDA annotations from the parser
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "LLVM_READONLY=" \
                         "LLVM_READNONE=" \
                         "LLVM_NODISCARD=" \
                         "LLVM_ATTRIBUTE_UNUSED=" \
                         "LLVM_ATTRIBUTE_NORETURN=" \
                         "LLVM_ATTRIBUTE_ALWAYS_INLINE=" \
                         "LLVM_LIKELY(x)=x" \
                         "LLVM_UNLIKELY(x)=x" \
                         "LLVM_EXPLICIT=explicit" \
                         "LLVM_CONSTEXPR=constexpr" \
                         "LLVM_NOEXCEPT=noexcept" \
                         "alignas(x)=" \
                         "__global__=" \
                         "__device__=" \
                         "__host__=" \
                         "__forceinline__=inline"

# Warnings
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = "@PROJECT_BINARY_DIR@/docs/doxygen_warnings.log"

# HTML output (doxygen-awesome-css, sidebar-only layout)
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 280
HTML_DYNAMIC_SECTIONS  = YES
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = "@AWESOME_CSS_DIR@/doxygen-awesome.css" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only.css"

# Graphs (need Graphviz; HAVE_DOT is YES/NO depending on whether CMake found it)
# Class, collaboration, include, group and directory graphs are on by default.
HAVE_DOT               = @Doxygen_dot_FOUND@
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
UML_LOOK               = YES
TEMPLATE_RELATIONS     = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_GRAPH_MAX_NODES    = 100